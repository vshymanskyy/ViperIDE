{
  "name": "ViperIDE",
  "version": "0.6.5",
  "description": "An innovative MicroPython / CircuitPython IDE for Web and Mobile. Built-in editor, file explorer, REPL, compiler, linter and device connectivity tools for embedded and web projects.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rollup --config",
    "build:local": "node scripts/build-local.mjs build",
    "start": "rollup --config --configDebug --watch",
    "start:local": "node scripts/build-local.mjs start",
    "lint": "npx eslint",
    "test": "npx mocha && npm run test:unit",
    "test:browser": "playwright test --grep-invert @network",
    "test:browser:network": "playwright test --grep @network",
    "test:browser:ui": "playwright test --ui",
    "test:local": "node scripts/build-local.mjs test",
    "test:unit": "npx mocha --no-config \"test/unit/**/*.js\""
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.5",
    "@astral-sh/ruff-wasm-web": "0.16.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/legacy-modes": "^6.5.3",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@gera2ld/tarjs": "^0.3.1",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "@mp-typing/lsp-client": "0.3.7",
    "@mp-typing/pyright-worker": "0.4.9",
    "@uiw/codemirror-theme-material": "^4.25.11",
    "@uiw/codemirror-theme-monokai": "^4.25.11",
    "@vshymanskyy/mpy-cross-wasm": "https://github.com/vshymanskyy/mpy-cross-wasm/releases/download/v1.1.0/vshymanskyy-mpy-cross-wasm-1.1.0.tgz",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "github-fork-ribbon-css": "^0.2.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "marked": "^18.0.9",
    "peerjs": "^1.5.5",
    "toastr": "^2.1.4",
    "ua-parser-js": "^2.0.10",
    "web-serial-polyfill": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "http-server": "^14.1.1",
    "mocha": "^11.8.0",
    "rollup": "^4.62.4",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-sourcemaps2": "^0.5.8",
    "serialport": "^13.0.0"
  }
}
